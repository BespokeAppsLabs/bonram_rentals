# Bonram Rentals - Environment Variables
# Copy this file to .env.local and fill in your values

# ============================================
# CONVEX CONFIGURATION
# ============================================
# Get these from your Convex dashboard: https://dashboard.convex.dev
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# ============================================
# WORKOS AUTHKIT (via Convex Auto-Provision)
# ============================================
# These are auto-populated by `npx convex dev` with convex.json authKit config.
# If manually configuring, get from: https://dashboard.workos.com/get-started
WORKOS_CLIENT_ID=client_your_client_id
WORKOS_API_KEY=sk_test_your_api_key
WORKOS_COOKIE_PASSWORD=your_secure_password_at_least_32_chars
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# ============================================
# RESEND (Staff Invitation Emails)
# ============================================
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key

# ============================================
# GOOGLE MAPS API (Optional)
# ============================================
# For location autocomplete in the Quick-Start Bar
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ============================================
# APPLICATION SETTINGS
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
